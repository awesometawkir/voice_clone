# Everything here is optional. The writing model can also be set in the app under Settings.
DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1

# Writing assistant: "ollama" (a model on this PC) or "api" (any OpenAI-compatible endpoint)
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3:8b
# Keep the local writing model off the GPU so it never competes with the voice model
OLLAMA_USE_GPU=0
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=

# Speech-to-text model sizes (tiny, base, small, medium, large-v3). Bigger is slower and more accurate.
WHISPER_MODEL=small
WHISPER_CHECK_MODEL=base
